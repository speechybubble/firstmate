#!/usr/bin/python3
# Stand-in for the Claude Code CLI: keeps Claude's on-disk session store
# (<config>/sessions/<pid>.json and projects/<slug>/<id>.jsonl) the way
# Claude Code 2.x does, runs the UserPromptSubmit/Stop/SessionEnd hooks from
# <cwd>/.claude/settings.local.json, draws a Claude 2.x composer, Escape
# clears the composer, and /exit exits.
import os, sys, re, json, uuid, signal, subprocess, tty, termios
cfg = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(os.environ["HOME"], ".claude")
argv = sys.argv[1:]
resumed = "--resume" in argv
sid = argv[argv.index("--resume") + 1] if resumed else None
cwd = os.path.realpath(os.getcwd())
pdir = os.path.join(cfg, "projects", re.sub(r"[^A-Za-z0-9]", "-", cwd))
os.makedirs(pdir, exist_ok=True)
if sid:
    tr = os.path.join(pdir, sid + ".jsonl")
    if not os.path.isfile(tr):
        print("No conversation found with session ID: " + sid); sys.exit(1)
else:
    sid = str(uuid.uuid4()); tr = os.path.join(pdir, sid + ".jsonl")
pid = os.getpid()
start = open("/proc/self/stat").read().rsplit(")", 1)[1].split()[19]
os.makedirs(os.path.join(cfg, "sessions"), exist_ok=True)
rec = os.path.join(cfg, "sessions", "%d.json" % pid)
json.dump({"pid": pid, "sessionId": sid, "cwd": cwd, "procStart": start, "kind": "interactive"}, open(rec, "w"))
def log(obj):
    with open(tr, "a") as f: f.write(json.dumps(obj) + "\n")
def hooks(event):
    try: s = json.load(open(os.path.join(cwd, ".claude", "settings.local.json")))
    except Exception: return
    for group in s.get("hooks", {}).get(event, []):
        for h in group.get("hooks", []):
            subprocess.run(h["command"], shell=True, cwd=cwd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
history = []
if resumed:
    for l in open(tr):
        try: o = json.loads(l)
        except Exception: continue
        if o.get("type") == "user": history.append(o["text"])
brief = [a for a in argv if "Firstmate operational input waiting" in a]
log({"type": "launch", "pid": pid, "resumed": resumed, "restored_user_turns": len(history),
     "fm_env": {k: v for k, v in os.environ.items() if k.startswith("FM_")}, "brief_doorbell": brief})
fd = sys.stdin.fileno(); old = termios.tcgetattr(fd)
def bye(*_):
    hooks("SessionEnd")
    try: os.unlink(rec)
    except FileNotFoundError: pass
    termios.tcsetattr(fd, termios.TCSADRAIN, old); sys.exit(0)
signal.signal(signal.SIGTERM, bye); signal.signal(signal.SIGHUP, bye)
buf = ""
def draw():
    w = sys.stdout.write
    w("\x1b[2J\x1b[H")
    w(" Claude Code (stand-in)  session %s%s\r\n" % (sid, "  [resumed]" if resumed else ""))
    w(" cwd: %s\r\n" % cwd)
    for t in history[-3:]: w(" > %s\r\n" % t)
    w("─" * 60 + "\r\n"); row = 4 + len(history[-3:])
    w("❯ " + buf + "\r\n"); w("─" * 60 + "\r\n"); w("  ? for shortcuts")
    w("\x1b[%d;%dH" % (row, 3 + len(buf))); sys.stdout.flush()
if brief:
    hooks("UserPromptSubmit"); history.append("<launch brief doorbell>"); hooks("Stop")
if os.environ.get("HERDR_PANE_ID"):
    # Real Claude registers with Herdr through its integration; the stand-in
    # registers itself the same way so Herdr's agent registry sees it.
    subprocess.run(["herdr", "pane", "report-agent", os.environ["HERDR_PANE_ID"], "--source", "claude-standin",
                    "--agent", "claude", "--state", "idle"] + (["--session", os.environ["HERDR_SESSION"]] if os.environ.get("HERDR_SESSION") else []),
                   stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
tty.setraw(fd); draw()
while True:
    ch = os.read(fd, 1).decode("utf-8", "ignore")
    if ch == "": bye()
    if ch == "\x1b": buf = ""
    elif ch in ("\r", "\n"):
        line, buf = buf.strip(), ""
        if not line: pass
        elif line in ("/exit", "/quit"): log({"type": "command", "text": line}); bye()
        else:
            hooks("UserPromptSubmit"); log({"type": "user", "text": line}); history.append(line); hooks("Stop")
    elif ch in ("\x7f", "\b"): buf = buf[:-1]
    elif ch == "\x03": buf = ""
    elif ch >= " ": buf += ch
    draw()
